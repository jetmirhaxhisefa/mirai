{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mirai/review-verdict/1",
  "title": "Review verdict",
  "description": "The reviewer's final structured output (unit 09a, R-M7): a verdict and its findings. Captured by the launcher, never read from a file (R2-C1); MIRAI re-checks it and decides from its own triage, never from `verdict` alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "findings"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "pass",
        "changes"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "category",
        "claim"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "description": "A short id, unique in this output."
        },
        "prior": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "description": "From round 2: the id of the earlier round's finding this one carries over."
        },
        "severity": {
          "enum": [
            "blocking",
            "should-fix",
            "nit"
          ]
        },
        "category": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "description": "A lower-case name, such as correctness or security."
        },
        "file": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?![A-Za-z]:)(?!(?:.*/)?\\.{1,2}(?:/|$))[^/\\\\\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff](?:[^/\\\\\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff]*[^/\\\\\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff])?(?:/[^/\\\\\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff](?:[^/\\\\\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff]*[^/\\\\\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff])?)*$",
          "description": "The file, relative to the repo, at most 256 characters."
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff]*[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff][^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff]*$",
          "description": "The function, method or class the finding is about; a blocking finding needs it."
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff]*[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff][^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff]*$",
          "description": "One line, at most 1000 characters."
        },
        "suggestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff]*[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff][^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2060-\\u2069\\ufeff]*$",
          "description": "One line, at most 1000 characters."
        }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ac",
            "adr",
            "rule",
            "repro"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[\\x20-\\x7e]*[\\x21-\\x7e][\\x20-\\x7e]*$",
          "description": "An AC, ADR or rule ID, or a one-line repro command; printable ASCII."
        }
      }
    }
  }
}
